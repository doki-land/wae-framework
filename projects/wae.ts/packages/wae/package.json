{
    "name": "@wae/wae",
    "version": "0.0.3",
    "type": "module",
    "description": "WAE meta CLI: scaffold, build, stage native npm addons, and publish",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/doki-land/wae-framework.git",
        "directory": "projects/wae.ts/packages/wae"
    },
    "bin": {
        "wae": "dist/cli.js"
    },
    "main": "./dist/cli.js",
    "types": "./dist/cli.d.ts",
    "exports": {
        ".": {
            "types": "./dist/cli.d.ts",
            "default": "./dist/cli.js"
        },
        "./native": {
            "types": "./dist/native.d.ts",
            "default": "./dist/native.js"
        }
    },
    "files": [
        "dist",
        "locales",
        "templates",
        "readme.md"
    ],
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "prepack": "node scripts/vendor-templates.mjs",
        "test": "node --import ../wae-commander/scripts/resolve-ts-from-js.mjs --test --experimental-strip-types ./tests/*.test.ts"
    },
    "dependencies": {
        "@wae/commander": "workspace:*"
    },
    "optionalDependencies": {
        "@wae/wae-darwin-arm64": "0.0.3",
        "@wae/wae-linux-x64": "0.0.3",
        "@wae/wae-win32-x64": "0.0.3"
    },
    "devDependencies": {
        "@types/node": "^22.15.0",
        "typescript": "^5.8.3"
    },
    "keywords": [
        "wae",
        "cli"
    ]
}
