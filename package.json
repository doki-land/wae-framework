{
    "name": "@wae/workspace",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@10.28.0",
    "description": "WAE: Rust library crates + TypeScript meta CLI / commander",
    "repository": "https://github.com/doki-land/wae-framework",
    "homepage": "https://github.com/doki-land/wae-framework",
    "license": "MIT",
    "scripts": {
        "check:rust": "cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace",
        "build:ts": "pnpm -r --filter \"./projects/wae.ts/packages/**\" run build",
        "build:napi": "node --experimental-strip-types scripts/build-napi.ts",
        "stage:napi": "node --experimental-strip-types scripts/stage-native.ts",
        "smoke:napi": "node --experimental-strip-types scripts/smoke-native.ts",
        "test:ts": "pnpm -r --filter \"./projects/wae.ts/packages/**\" run test",
        "test": "pnpm run check:rust && pnpm run test:ts",
        "wae": "pnpm --filter @wae/wae exec node ./dist/cli.js"
    },
    "devDependencies": {
        "@doki-land/nifty": "^0.1.10",
        "@wae/commander": "workspace:*",
        "@wae/wae": "workspace:*"
    }
}
